  {
    "id": "validate_telemetria",
    "type": "function",
    "z": "tab_elevador_2026",
    "name": "Validar datos",
    "func": "let d=msg.payload;\nif(typeof d==='string'){try{d=JSON.parse(d)}catch(e){node.warn('JSON invalido');return null}}\nif(!d || typeof d!=='object' || ![1,2,3].includes(Number(d.piso))){node.warn('Telemetria invalida');return null;}\nmsg.payload={piso:Number(d.piso),destino:Number(d.destino),estado:String(d.estado),emergencia:d.emergencia===true || d.emergencia==='true',posicion:Number(d.posicion),tiempo_ms:Number(d.tiempo_ms)};\nmsg._esPrueba=Boolean(msg._esPrueba);\nmsg.payload.origen=msg._esPrueba?'PRUEBA LOCAL':'WOKWI / MQTT';\nmsg.payload.recibido=Date.now();\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 565,
    "y": 100,
    "wires": [
