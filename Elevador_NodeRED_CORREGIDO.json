  {
    "id": "panel_ui",
    "type": "ui-template",
    "z": "tab_elevador_2026",
    "group": "grupo_elevador_2026",
    "page": "",
    "ui": "",
    "name": "Panel sencillo 3 pisos",
    "order": 1,
    "width": "12",
    "height": "8",
    "head": "",
    "format": "<template>\n<div class=\"elev\">\n  <div class=\"head\"><div><h2>Elevador inteligente</h2><p>Monitoreo de 3 pisos · ESP32 + Node-RED · <b>{{ msg?.payload?.origen ?? \"Sin conexión de datos\" }}</b></p></div><span class=\"status\" :class=\"msg?.payload?.emergencia ? 'bad':'good'\">{{msg?.payload?.emergencia ? 'Emergencia' : (msg?.payload?.origen ?? 'Sin telemetría')}}</span></div>\n  <div class=\"stats\">\n   <div><small>Piso actual</small><strong>{{ msg?.payload?.piso ?? '—' }}</strong></div>\n   <div><small>Destino</small><strong>{{ msg?.payload?.destino ?? '—' }}</strong></div>\n   <div><small>Estado</small><b>{{ msg?.payload?.estado ?? 'Esperando datos' }}</b></div>\n   <div><small>Motor (pasos)</small><b>{{ msg?.payload?.posicion ?? '—' }}</b></div>\n  </div>\n  <div class=\"layout\">\n   <section><h3>Seleccionar piso</h3><div class=\"buttons\"><button v-for=\"n in [1,2,3]\" :key=\"n\" @click=\"go(n)\">Piso {{n}}</button></div><p class=\"hint\">Las órdenes se envían por MQTT; el ESP32 confirma el movimiento mediante telemetría.</p></section>\n   <section><h3>Estado del sistema</h3><div class=\"pill\" :class=\"msg?.payload?.emergencia ? 'bad':'good'\">{{msg?.payload?.emergencia ? 'PARO ACTIVADO' : (msg?.payload?.estado ?? 'Sin telemetría')}}</div><p class=\"hint\">El paro de emergencia solo se activa desde el interruptor de Wokwi.</p></section>\n  </div>\n  <div class=\"foot\">Piso 1 = 0 pasos · Piso 2 = 200 · Piso 3 = 400</div>\n</div>\n</template>\n<script>\nexport default {methods:{go(n){this.send({payload:String(n)})}}}\n</script>\n<style>\n.elev{font-family:Arial,sans-serif;max-width:1100px;margin:auto;padding:15px;color:#182b45}.elev .head{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}.elev h2{font-size:26px;margin:0}.elev p{color:#54677f;margin:6px 0}.elev .status,.elev .pill{padding:10px 14px;border-radius:9px;font-weight:bold}.elev .good{background:#dcfce7;color:#166534}.elev .bad{background:#fee2e2;color:#991b1b}.elev .stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:20px 0}.elev .stats>div,.elev section{border:1px solid #dce4f0;border-radius:12px;background:#fff;padding:18px}.elev small{display:block;color:#63758e;font-size:13px}.elev strong{font-size:38px;color:#1d4ed8}.elev b{font-size:19px}.elev .layout{display:grid;grid-template-columns:1fr 1fr;gap:12px}.elev h3{margin-top:0}.elev .buttons{display:flex;gap:10px}.elev button{border:0;border-radius:8px;background:#2563eb;color:white;padding:14px 18px;cursor:pointer;font-weight:bold}.elev button:hover{background:#1d4ed8}.elev .hint{font-size:13px}.elev .foot{padding-top:14px;font-size:12px;color:#64748b}@media(max-width:760px){.elev .stats{grid-template-columns:repeat(2,1fr)}.elev .layout{grid-template-columns:1fr}.elev .buttons{flex-wrap:wrap}}\n</style>",
    "storeOutMessages": true,
    "passthru": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 780,
    "y": 100,
    "wires": [
